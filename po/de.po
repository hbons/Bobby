# ---------------------------------------------------------------------------
# AppStream metainfo
# ---------------------------------------------------------------------------
#: data/studio.planetpeanut.Bobby.metainfo.xml.in:56
msgid ""
"Bobby lets you open SQLite database files (.db, .sqlite) and browse the "
"tables inside. Handy for app development or inspecting downloaded databases."
msgstr ""
"Mit Bobby öffnest du SQLite-Datenbankdateien (.db, .sqlite) und durchsuchst "
"die enthaltenen Tabellen. Praktisch für die App-Entwicklung oder zum "
"Inspizieren heruntergeladener Datenbanken."

#: data/studio.planetpeanut.Bobby.metainfo.xml.in:61
msgid "Scroll through tables and views of any size"
msgstr "Durch Tabellen und Ansichten beliebiger Größe blättern"

#: data/studio.planetpeanut.Bobby.metainfo.xml.in:62
msgid "Copy rows or cells to the clipboard"
msgstr "Zeilen oder Zellen in die Zwischenablage kopieren"

#: data/studio.planetpeanut.Bobby.metainfo.xml.in:63
msgid "Made with care by a human"
msgstr "Mit Sorgfalt von einem Menschen erstellt"

#: data/studio.planetpeanut.Bobby.metainfo.xml.in:65
msgid "Don't forget to sanitize your database inputs!"
msgstr "Vergiss nicht, deine Datenbankeingaben zu bereinigen!"

